# Copy to .env (gitignored) and fill in the real values from your new
# Supabase project → Project Settings → API.
#
# These are PUBLIC values (safe to ship in the client bundle). The
# service-role key is NEVER placed here — it lives only as a Supabase
# Edge Function secret (see supabase/functions/*).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: the deployed web app URL (used for deep links / share URLs).
EXPO_PUBLIC_WEBAPP_URL=https://your-vercel-deployment.vercel.app
