{
  "name": "fahrschule-abgefahrn-app",
  "version": "1.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild",
    "doctor": "npx expo-doctor",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "build:all": "eas build --platform all --profile production",
    "submit:ios": "eas submit --platform ios --latest",
    "submit:android": "eas submit --platform android --latest",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:public": "playwright test --project=public",
    "test:db": "bash scripts/db-test.sh",
    "test:load:db": "bash scripts/db-load.sh",
    "test:load:web": "node scripts/load-test.mjs",
    "security:probe": "node scripts/security-probe.mjs",
    "audit:deps": "node scripts/audit.mjs",
    "check:bundle": "node scripts/check-bundle.mjs dist",
    "check:functions": "deno lint --config supabase/functions/deno.json supabase/functions && deno check --config supabase/functions/deno.json supabase/functions/*/index.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.117.2",
    "date-fns": "^4.1.0",
    "expo": "~54.0.35",
    "expo-asset": "~58.0.20",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-local-authentication": "~58.0.2",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.7",
    "fflate": "^0.8.2",
    "nativewind": "^4.1.23",
    "phosphor-react-native": "^3.0.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.6",
    "react-native-css-interop": "^0.2.7",
    "react-native-gesture-handler": "~3.5.0",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.1",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.10.0",
    "@types/react": "~19.1.17",
    "babel-preset-expo": "~54.0.10",
    "react-refresh": "^0.14.2",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": "^8.5.29",
    "uuid": "^11.1.1",
    "sprintf-js": "^1.1.3"
  }
}
